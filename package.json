{
  "name": "austria-map-card",
  "private": true,
  "version": "0.1.0",
  "description": "Standalone Lovelace custom card — a zoomable layer map of Austria, drawn from official open data.",
  "type": "module",
  "scripts": {
    "build": "rolldown -c",
    "dev": "rolldown -c -w",
    "build:data": "node scripts/build-data.mjs",
    "build:push": "./scripts/dev-push.sh --quiet",
    "preview": "node scripts/preview.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include=src/** --coverage.reporter=json --coverage.reporter=text-summary"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.10",
    "@vitest/coverage-v8": "5.0.3",
    "happy-dom": "20.14.5",
    "rolldown": "1.2.13",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "lit": "^3.3.3"
  }
}
