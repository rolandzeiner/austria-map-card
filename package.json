{
  "name": "austria-map-card",
  "version": "0.2.0",
  "private": true,
  "description": "Standalone Lovelace custom card — a zoomable layer map of Austria, drawn from official open data.",
  "type": "module",
  "scripts": {
    "build": "vp build",
    "dev": "vp build --watch --mode development",
    "build:data": "node scripts/build-data.mjs",
    "build:push": "./scripts/dev-push.sh --quiet",
    "preview": "node scripts/preview.mjs",
    "test": "vp test run",
    "test:watch": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.10",
    "happy-dom": "21.0.4",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.0.0"
    },
    "runtime": {
      "name": "node",
      "version": "^24.11.0 || >=26.0.0"
    }
  }
}
